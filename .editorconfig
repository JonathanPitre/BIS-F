# EditorConfig — https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{ps1,psm1,psd1,psc1,ps1xml,clixml}]
charset = utf-8-bom
end_of_line = crlf

[*.{xml,txt,cmd,bat}]
end_of_line = crlf

[*.md]
trim_trailing_whitespace = false

[LICENSE]
end_of_line = lf
